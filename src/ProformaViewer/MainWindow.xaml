<Window x:Class="ProformaViewer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Proforma Viewer" Width="1180" Height="760" MinWidth="850" MinHeight="560" Background="#F3F6FA" WindowStartupLocation="CenterScreen">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#172033" Padding="28,22"><DockPanel><StackPanel><TextBlock Text="PROFORMA VIEWER" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="SubTitle" Text="Choose a fleet database" Foreground="#B8C5D9" Margin="0,5,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="Change database" Click="Home_Click" Background="#334155" Foreground="White" Visibility="Collapsed" x:Name="HomeButton"/></DockPanel></Border>
  <Border Grid.Row="1" Background="White" Padding="22,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" FontSize="15" Padding="12,9" TextChanged="Search_TextChanged" ToolTip="Search titles and filenames" Visibility="Collapsed"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="SelectAllButton" Content="Select all" Click="SelectAll_Click" Margin="12,0,0,0" Visibility="Collapsed"/><Button x:Name="ClearButton" Content="Clear" Click="Clear_Click" Margin="8,0,0,0" Visibility="Collapsed"/></StackPanel></Grid></Border>
  <Grid Grid.Row="2"><StackPanel x:Name="HomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="620"><TextBlock Text="Select fleet" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ink}"/><TextBlock Text="The latest workbook is loaded from the network when selected." HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,8,0,28"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="AT300" Tag="AT300" Click="Database_Click" Style="{StaticResource PrimaryButton}" FontSize="24" Height="115" Margin="8"/><Button Grid.Column="1" Content="AT200" Tag="AT200" Click="Database_Click" Style="{StaticResource PrimaryButton}" FontSize="24" Height="115" Margin="8"/></Grid></StackPanel>
   <ListBox x:Name="ItemsList" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="18" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Width="345" MinHeight="132" Margin="7" Padding="16" Background="White" CornerRadius="10" BorderBrush="#DCE3ED" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,3,13,0" Click="Selection_Click"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource Ink}" FontSize="14"/><TextBlock Text="{Binding PageLabel}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Text="{Binding FileName}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Path}"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
  </Grid>
  <Border Grid.Row="3" Background="White" Padding="22,14"><DockPanel><TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ProgressBar x:Name="Progress" Width="150" Height="8" Margin="0,0,15,0" Visibility="Collapsed"/><Button x:Name="ExportButton" Content="Export selected pages" Style="{StaticResource PrimaryButton}" Click="Export_Click" IsEnabled="False" Visibility="Collapsed"/></StackPanel></DockPanel></Border>
 </Grid>
</Window>
